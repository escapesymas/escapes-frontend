{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/proxy-wc/wp-json/(.*)",
      "destination": "https://backendescapes.com/wp-json/$1"
    },
    {
      "source": "/((?!api/|robots\\.txt|sitemap\\.xml|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}